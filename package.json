{
  "name": "vscintegratedtwitchchat",
  "displayName": "Twitch Chat in VSCode",
  "description": "A VSC Extension to open Twitch Chat in a new File Tab",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.131.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "twitch-chat.open",
        "title": "Twitch: Chat öffnen"
      }
    ]
  },
  "scripts": {
    "precompile": "node utils/cleanOutput.cjs",
    "compile": "tsc -p tsconfig.json",
    "postcompile": "node utils/copyPublicToOutput.cjs",
    "test": "test",
    "prestartpackagepipeline":"npm install",
    "startpackagepipeline":"vsce package --skip-license",
    "vscode:prepublish": "npm run compile",
    "precompilefortest": "node utils/cleanOutput.cjs",
    "compilefortest":"tsc -p tsconfig.test.json",
    "postcompilefortest":"node utils/copyPublicToOutput.cjs"
  },
  "author": "schmeling65",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.131.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
